# Secrets only. Everything else belongs in optimiztresearch.yaml, which is
# committed; this file is not (see .gitignore).
#
# Anything OPTIMIZTRESEARCH_* set here still overrides the YAML, which is
# occasionally useful for a machine-local tweak -- but prefer the YAML,
# because a key repeated in a .env silently takes its last value.

# Model providers. You need the key for whichever provider the model specs in
# optimiztresearch.yaml point at. Ollama needs none.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional. Without it Semantic Scholar is skipped entirely -- its
# unauthenticated pool 429s under even light use, so an unkeyed run would
# spend search budget to return nothing. OpenAlex carries the citation graph
# with no key. See `semantic_scholar` in optimiztresearch.yaml.
# Key request form: https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=

# Only needed if 'web' is in enabled_sources.
TAVILY_API_KEY=

# Optional; raises PubMed from 3 to 10 req/sec.
NCBI_API_KEY=
