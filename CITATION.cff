    family-names: Panapitiya
version: 0.1.0
date-released: "2026-10-16"
license: Apache-2.0
repository-code: "https://github.com/gihanpanapitiya/optimist_research"
keywords:
  - LLM agents
  - literature review automation
  - retrieval-augmented generation
  - citation snowballing
  - evidence synthesis
  - LangGraph
